                  "$ref": "#/components/schemas/StatementOne"
                }
              }
            }
          },
          "400": {
            "description": "Empty body, unknown/read-only field or DB constraint error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "statements"
        ],
        "summary": "Update statements row (partial)",
        "operationId": "patch_statements",
        "parameters": [
          {
            "name": "row_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
