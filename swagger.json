{
  "openapi": "3.0.3",
  "info": {
    "title": "ccDataLedger API",
    "version": "1.0.0",
    "description": "Import credit-card statement JSON (ccDataExtractor output) into a file-based SQLite DB and view/update it. Amounts and dates are stored as the text found in the JSON."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/ccDataLedger/import": {
      "post": {
        "tags": [
          "Import"
        ],
        "summary": "Import statement JSON file(s) into the four tables",
        "operationId": "importJson",
        "description": "Upload one or more statement JSON files as repeated `file` fields. Re-importing the same `source_file` replaces that statement and its children.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "At least one statement imported (`success` or `partial`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or nothing imported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ccDataLedger/statements": {
      "get": {
        "tags": [
          "statements"
        ],
        "summary": "List statements",
        "operationId": "list_statements",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "source_file",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact-match column filter"
          },
          {
            "name": "cardholder",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact-match column filter"
          }
        ],
        "description": "Any other column name is also accepted as an exact-match filter.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementList"
                }
              }
            }
          }
        }
      }
    },
    "/ccDataLedger/statements/{row_id}": {
      "get": {
        "tags": [
          "statements"
        ],
        "summary": "Get one row of statements",
